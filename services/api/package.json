    "@vitest/coverage-v8": "5.1.0",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.21.0",
